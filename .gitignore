# Published surface: the frlgsim/ simulator package plus the root entry script
# frlgtrade.py. Everything else is local to this setup.

# Ignore every top-level folder except the frlgsim package and its test suite.
# This covers utils/, notes/, captures/, .backups/, and venv/.
/*/
!/frlgsim/
!/tests/
!/pokefirered/

# Never publish Pokemon data files (live-trade outputs can carry trainer/account
# identifiers); covers any stray .pk3/.ek3 at the root or inside frlgsim/ too.
*.pk3
*.ek3

# Python bytecode (applies inside frlgsim/ as well)
__pycache__/
*.pyc

# Nested standalone clone (Goppier/Gen3DistributionRoms) — its own git repo,
# kept local so its changes never touch this repo.
Gen3DistributionRoms/

# Nested standalone clone (kinnay/LDN) — reference source for the LDN hosting
# stack (@ 39d0b20 = v0.0.17, identical to the installed venv package).
LDN/

# Generated hosting-debug artifact (ldn_debug_report.sh output; system details)
ldn-debug-report.txt
