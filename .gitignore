# Published surface: the frlgsim/ simulator package plus the root entry script
# frlgtrade.py. Everything else is local to this setup.

# Ignore every top-level folder except the frlgsim package.
# This covers tests/, docs/, utils/, notes/, captures/, .backups/, and venv/.
/*/
!/frlgsim/

# Never publish Pokemon data files (live-trade outputs can carry trainer/account
# identifiers); covers any stray .pk3/.ek3 at the root or inside frlgsim/ too.
*.pk3
*.ek3

# Local ROM dumps and save files used for offline testing (e.g. frlgsim's
# POKEMON_FIRE_BPRE01.gba/.sav) - copyrighted and/or carry live trainer data.
*.gba
*.sav

# Python bytecode (applies inside frlgsim/ as well)
__pycache__/
*.pyc

# Runtime logs, protocol traces, and packet captures may contain console,
# trainer, or network identifiers and should stay local.
*.log
*.jsonl
*.pcap
*.pcapng
host-tap-*.txt
